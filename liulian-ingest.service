# LIULIAN ingest service control-plane systemd service
# Install: sudo cp liulian-ingest.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable liulian-ingest
#
# Before installing, replace:
#   <DEPLOY_USER>   - the user running the crawler (e.g. wenjixu)
#   <CRAWLER_DIR>   - absolute path to the crawler repo (e.g. /home/<user>/liulian/liulian-ingest)

[Unit]
Description=LIULIAN ingest service (data crawler) (FastAPI)
After=network.target

[Service]
Type=simple
User=<DEPLOY_USER>
WorkingDirectory=<CRAWLER_DIR>
ExecStart=<CRAWLER_DIR>/.venv/bin/uvicorn crawler.api.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/liulian-ingest/env

[Install]
WantedBy=multi-user.target

